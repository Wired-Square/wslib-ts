{
  "name": "@wired-square/chart",
  "version": "0.1.0",
  "description": "A framework-free time-series chart drawn as SVG, coloured by the --app-* tokens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:Wired-Square/wslib-ts",
    "directory": "packages/chart"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://forge.wiredsquare.com/api/packages/wired-square/npm/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
