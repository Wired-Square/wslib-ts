{
  "name": "@wired-square/appliance-types",
  "version": "0.1.1",
  "description": "The appliance's wire types and limits, generated by ts-rs from wslib-appliance-types.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:Wired-Square/wslib-ts",
    "directory": "packages/appliance-types"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
