{
  "name": "@wired-square/canvas",
  "version": "0.1.0",
  "description": "A pan and zoom board canvas: nodes, edges, connecting and chrome, framework-free with a Solid binding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:Wired-Square/wslib-ts",
    "directory": "packages/canvas"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./canvas.css": "./src/canvas.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "registry": "https://forge.wiredsquare.com/api/packages/wired-square/npm/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "solid-js": "^1.9.11"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.3",
    "solid-js": "^1.9.17",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
