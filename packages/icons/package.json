{
  "name": "@wired-square/icons",
  "version": "0.1.3",
  "description": "Wired Square's glyphs: plain SVG on a 24 grid, a sprite, their names, and Solid components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:Wired-Square/wslib-ts",
    "directory": "packages/icons"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./solid": {
      "solid": "./src/solid.tsx",
      "default": "./src/solid.tsx"
    },
    "./sprite.svg": "./dist/sprite.svg",
    "./glyphs/*.svg": "./dist/glyphs/*.svg"
  },
  "files": [
    "dist",
    "src/solid.tsx",
    "preview.svg"
  ],
  "publishConfig": {
    "registry": "https://forge.wiredsquare.com/api/packages/wired-square/npm/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/icons.mjs --dist",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "solid-js": "^1.9.11"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.3",
    "solid-js": "^1.9.17",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
