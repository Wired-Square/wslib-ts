# Copy to .env and fill in. .env is not committed.

# 1Password reference of your publish token (write:package).
WSLIB_REGISTRY_TOKEN_REF=op://<vault>/<item>/<field>

# The Forgejo instance and owner the registry lives under.
WSLIB_FORGE_URL=https://forge.example.com
WSLIB_FORGE_OWNER=<owner>

# The npm mirror's docroot as an rsync destination, ending in : or /
# (user@host:npm/ when the key is restricted to rrsync), and the URL it is served at.
WSLIB_MIRROR_DEST=<user>@<host>:npm/
WSLIB_NPM_MIRROR_URL=https://mirror.example.com/npm/
